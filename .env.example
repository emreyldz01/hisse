ONCHAIN_CHAIN=eth

### Price data (replace with your own key and endpoint)
PRICES_API_KEY=
PRICES_API_URL=https://api.binance.com/api/v3/klines
PRICES_SYMBOL=BTCUSDT

### Web crawling without an API
WEB_CRAWL_URLS=https://www.reuters.com/markets,https://www.reuters.com/technology
WEB_CRAWL_MAX_PAGES=5
WEB_CRAWL_SAME_DOMAIN_ONLY=true

### Queue/orchestration examples
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
PREFECT_DEPLOYMENT=true
