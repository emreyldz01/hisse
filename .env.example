### News headlines via NewsAPI (replace with your own key)
NEWS_API_KEY=0bba5d9dce1148b48a53451bb0cbb1d4
NEWS_API_URL=https://newsapi.org/v2/top-headlines
NEWS_REGIONS=tr

### Social data (replace with your own key and endpoint)
SOCIAL_API_KEY=your_social_api_key_here
SOCIAL_API_URL=https://social-api.example.com/v1/posts

### On-chain metrics (replace with your own key and endpoint)
ONCHAIN_API_KEY=your_onchain_api_key_here
ONCHAIN_API_URL=https://onchain.example.com/v1/metrics
ONCHAIN_CHAIN=eth

### Price data (replace with your own key and endpoint)
PRICES_API_KEY=your_prices_api_key_here
PRICES_API_URL=https://prices.example.com/v1/candles
PRICES_SYMBOL=BTCUSD

### Web crawling without an API
WEB_CRAWL_URLS=https://www.reuters.com/markets,https://www.reuters.com/technology
WEB_CRAWL_MAX_PAGES=5
WEB_CRAWL_SAME_DOMAIN_ONLY=true

### Queue/orchestration examples
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
PREFECT_DEPLOYMENT=true
