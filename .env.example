### Social data (replace with your own key and endpoint)
SOCIAL_API_KEY=NONE
SOCIAL_API_URL=https://hacker-news.firebaseio.com/v0

### On-chain metrics (replace with your own key and endpoint)
ONCHAIN_API_KEY=RDTKAIGFZ4JEFXFDUXFMWJRIYZJ1E7AKUY
